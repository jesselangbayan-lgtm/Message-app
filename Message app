<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Encrypted P2P Messenger</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- QR Code library (pure JS, no backend) -->
    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#ecfdf5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            900: '#064e3b'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .break-anywhere { overflow-wrap: anywhere; word-break: break-word; }
        #qr-modal { backdrop-filter: blur(4px); }
    </style>
</head>
<body class="h-full bg-slate-50 text-slate-800 flex flex-col font-sans antialiased">

    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center text-white shadow-md shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-slate-900 leading-tight">Encrypted P2P Channel</h1>
                    <p class="text-xs text-slate-500 flex items-center gap-1.5">
                        <span id="status-dot" class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                        <span id="status-text">Disconnected</span>
                    </p>
                </div>
            </div>
            <button id="reset-btn" class="hidden text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 px-3 py-1.5 rounded-lg font-medium transition flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                Reset
            </button>
        </div>
    </header>

    <main class="flex-1 max-w-3xl w-full mx-auto p-4 flex flex-col overflow-hidden">

        <!-- ========== SETUP VIEW ========== -->
        <div id="setup-view" class="space-y-5 my-auto py-2">

            <!-- Shared Password -->
            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                <div class="flex items-center justify-between">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Shared Secret</div>
                    <span class="text-[10px] text-slate-400">Both sides must use the same password</span>
                </div>
                <div class="relative">
                    <input type="password" id="shared-password" placeholder="Enter a shared password (min 8 chars)"
                           class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none pr-12"
                           autocomplete="off">
                    <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600">
                        <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                    </button>
                </div>
                <p class="text-xs text-slate-500">This password encrypts every message with AES-GCM. Never share it in the same channel you use for the tokens.</p>
            </div>

            <!-- Role Tabs -->
            <div class="bg-white p-1.5 rounded-2xl shadow-sm border border-slate-200 flex gap-2">
                <button id="role-host-btn" onclick="setRole('host')"
                        class="flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-emerald-500 text-white shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                    </svg>
                    Host
                </button>
                <button id="role-join-btn" onclick="setRole('join')"
                        class="flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-100">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                    </svg>
                    Join
                </button>
            </div>

            <!-- HOST PANEL -->
            <div id="panel-host" class="space-y-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Step 1 · Create Offer</div>
                    <p class="text-sm text-slate-600">Generate a connection token. Share the QR code or the short code + full token with your peer.</p>
                    <button id="gen-offer-btn" onclick="generateOffer()"
                            class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed text-white font-medium py-3 px-4 rounded-xl shadow transition flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                        <span id="gen-offer-label">Generate Offer Token</span>
                    </button>

                    <!-- Short Code + QR area (shown after generation) -->
                    <div id="offer-result" class="hidden space-y-3 pt-2">
                        <div class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">
                            <div>
                                <div class="text-[10px] uppercase tracking-wider text-emerald-600 font-semibold">Short Connection Code</div>
                                <div id="offer-short-code" class="text-2xl font-mono font-bold text-emerald-800 tracking-widest">----</div>
                            </div>
                            <button onclick="copyText('offer-short-code')" class="text-xs bg-white border border-emerald-200 hover:bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded-lg font-medium">
                                Copy Code
                            </button>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showQR('offer-output', 'Offer Token')"
                                    class="flex-1 bg-slate-900 hover:bg-slate-800 text-white text-sm font-medium py-2.5 rounded-xl flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                                </svg>
                                Show QR Code
                            </button>
                            <button onclick="copyText('offer-output')"
                                    class="flex-1 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium py-2.5 rounded-xl">
                                Copy Full Token
                            </button>
                        </div>
                        <details class="text-xs">
                            <summary class="cursor-pointer text-slate-500 hover:text-slate-700">Show full token (advanced)</summary>
                            <textarea id="offer-output" readonly rows="3"
                                      class="mt-2 w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-mono text-slate-600 focus:outline-none resize-none"></textarea>
                        </details>
                    </div>
                </div>

                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Step 2 · Accept Answer</div>
                    <p class="text-sm text-slate-600">Paste the answer token (or the short code + token) your peer sent back.</p>
                    <div class="space-y-1">
                        <label class="text-xs font-medium text-slate-500">Peer’s Answer Token</label>
                        <textarea id="host-answer-input" rows="3" placeholder="Paste full answer token here…"
                                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-mono text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none resize-none"></textarea>
                    </div>
                    <button id="accept-answer-btn" onclick="acceptAnswer()"
                            class="w-full bg-slate-900 hover:bg-slate-800 active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed text-white font-medium py-3 px-4 rounded-xl shadow transition flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        Establish Connection
                    </button>
                </div>
            </div>

            <!-- JOIN PANEL -->
            <div id="panel-join" class="hidden space-y-4">
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Step 1 · Accept Offer</div>
                    <p class="text-sm text-slate-600">Paste the offer token from the host (or scan their QR and paste).</p>
                    <div class="space-y-1">
                        <label class="text-xs font-medium text-slate-500">Peer’s Offer Token</label>
                        <textarea id="join-offer-input" rows="3" placeholder="Paste full offer token here…"
                                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-mono text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 focus:outline-none resize-none"></textarea>
                    </div>
                    <button id="gen-answer-btn" onclick="generateAnswer()"
                            class="w-full bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] disabled:opacity-60 disabled:cursor-not-allowed text-white font-medium py-3 px-4 rounded-xl shadow transition flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        <span id="gen-answer-label">Generate Answer Token</span>
                    </button>
                </div>

                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
                    <div class="text-xs font-semibold text-emerald-600 uppercase tracking-wider">Step 2 · Send Answer</div>
                    <p class="text-sm text-slate-600">Share the QR code or short code + full token back to the host.</p>

                    <div id="answer-result" class="hidden space-y-3">
                        <div class="flex items-center justify-between bg-emerald-50 border border-emerald-200 rounded-xl px-4 py-3">
                            <div>
                                <div class="text-[10px] uppercase tracking-wider text-emerald-600 font-semibold">Short Connection Code</div>
                                <div id="answer-short-code" class="text-2xl font-mono font-bold text-emerald-800 tracking-widest">----</div>
                            </div>
                            <button onclick="copyText('answer-short-code')" class="text-xs bg-white border border-emerald-200 hover:bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded-lg font-medium">
                                Copy Code
                            </button>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="showQR('answer-output', 'Answer Token')"
                                    class="flex-1 bg-slate-900 hover:bg-slate-800 text-white text-sm font-medium py-2.5 rounded-xl flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
                                </svg>
                                Show QR Code
                            </button>
                            <button onclick="copyText('answer-output')"
                                    class="flex-1 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-medium py-2.5 rounded-xl">
                                Copy Full Token
                            </button>
                        </div>
                        <details class="text-xs">
                            <summary class="cursor-pointer text-slate-500 hover:text-slate-700">Show full token (advanced)</summary>
                            <textarea id="answer-output" readonly rows="3"
                                      class="mt-2 w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs font-mono text-slate-600 focus:outline-none resize-none"></textarea>
                        </details>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========== CHAT VIEW ========== -->
        <div id="chat-view" class="hidden flex-1 flex flex-col h-full bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden my-2">
            <div class="bg-slate-50 border-b border-slate-200 p-3 px-4 flex items-center justify-between text-xs text-slate-500">
                <span class="flex items-center gap-1.5 font-medium text-emerald-600">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    End-to-End Encrypted · AES-GCM
                </span>
                <span id="conn-detail" class="text-slate-400">Direct P2P</span>
            </div>

            <div id="messages-container" class="flex-1 p-4 overflow-y-auto space-y-3 bg-slate-50/50">
                <div class="text-center my-2">
                    <span class="bg-slate-200/70 text-slate-600 text-[11px] px-3 py-1 rounded-full font-medium">
                        Secure channel ready. Messages are encrypted with your shared password.
                    </span>
                </div>
            </div>

            <div class="p-3 bg-white border-t border-slate-200 flex items-center gap-2">
                <input type="text" id="chat-input" onkeydown="handleKey(event)" placeholder="Type a message…"
                       class="flex-1 bg-slate-100 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition"
                       autocomplete="off">
                <button onclick="sendMessage()"
                        class="bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white p-3 rounded-xl shadow transition flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                    </svg>
                </button>
            </div>
        </div>
    </main>

    <!-- QR Modal -->
    <div id="qr-modal" class="fixed inset-0 bg-black/60 z-[100] hidden items-center justify-center p-4" onclick="if(event.target===this) hideQR()">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl text-center space-y-4">
            <div class="flex items-center justify-between">
                <h3 id="qr-title" class="font-semibold text-slate-900">QR Code</h3>
                <button onclick="hideQR()" class="text-slate-400 hover:text-slate-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <canvas id="qr-canvas" class="mx-auto rounded-lg"></canvas>
            <p class="text-xs text-slate-500">Scan with your phone camera or a QR app, then copy the token that appears.</p>
            <div class="flex gap-2">
                <button onclick="copyCurrentQRToken()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium py-2.5 rounded-xl">
                    Copy Token
                </button>
                <button onclick="hideQR()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium py-2.5 rounded-xl">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-xs px-4 py-2.5 rounded-xl shadow-lg transition-all duration-300 opacity-0 pointer-events-none z-50 flex items-center gap-2 max-w-[90vw]">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <span id="toast-msg">Action successful</span>
    </div>

<script>
/* ============================================================
   Encrypted P2P Messenger
   - Max connection success (STUN + free TURN)
   - Fully serverless
   - Shared-password AES-GCM encryption
   - QR codes + short connection codes
   ============================================================ */

let peerConnection = null;
let dataChannel = null;
let currentRole = 'host';
let cryptoKey = null;
let isGathering = false;
let tokenFinalized = false;
let currentQRToken = '';   // for the modal copy button

// Public STUN + free TURN (Metered OpenRelay)
const rtcConfig = {
    iceServers: [
        { urls: 'stun:stun.l.google.com:19302' },
        { urls: 'stun:stun1.l.google.com:19302' },
        { urls: 'stun:stun.stunprotocol.org:3478' },
        {
            urls: 'turn:openrelay.metered.ca:80',
            username: 'openrelayproject',
            credential: 'openrelayproject'
        },
        {
            urls: 'turn:openrelay.metered.ca:443',
            username: 'openrelayproject',
            credential: 'openrelayproject'
        },
        {
            urls: 'turn:openrelay.metered.ca:443?transport=tcp',
            username: 'openrelayproject',
            credential: 'openrelayproject'
        }
    ],
    iceCandidatePoolSize: 10
};

/* ---------- Short code generator ---------- */
function generateShortCode() {
    // 6-char alphanumeric, easy to read aloud
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // no I/O/0/1 to avoid confusion
    let code = '';
    const arr = new Uint8Array(6);
    crypto.getRandomValues(arr);
    for (let i = 0; i < 6; i++) {
        code += chars[arr[i] % chars.length];
    }
    return code;
}

/* ---------- UI helpers ---------- */
function setRole(role) {
    currentRole = role;
    const hostBtn = document.getElementById('role-host-btn');
    const joinBtn = document.getElementById('role-join-btn');
    const hostPanel = document.getElementById('panel-host');
    const joinPanel = document.getElementById('panel-join');

    if (role === 'host') {
        hostBtn.className = 'flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-emerald-500 text-white shadow-sm';
        joinBtn.className = 'flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-100';
        hostPanel.classList.remove('hidden');
        joinPanel.classList.add('hidden');
    } else {
        joinBtn.className = 'flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 bg-emerald-500 text-white shadow-sm';
        hostBtn.className = 'flex-1 py-2.5 px-4 rounded-xl font-semibold text-sm transition flex items-center justify-center gap-2 text-slate-600 hover:bg-slate-100';
        joinPanel.classList.remove('hidden');
        hostPanel.classList.add('hidden');
    }
    resetPeerConnection();
}

function resetPeerConnection() {
    if (peerConnection) {
        peerConnection.close();
        peerConnection = null;
    }
    dataChannel = null;
    cryptoKey = null;
    isGathering = false;
    tokenFinalized = false;
    updateStatus('Disconnected', 'bg-amber-500');
    document.getElementById('setup-view').classList.remove('hidden');
    document.getElementById('chat-view').classList.add('hidden');
    document.getElementById('reset-btn').classList.add('hidden');
    document.getElementById('offer-output').value = '';
    document.getElementById('answer-output').value = '';
    document.getElementById('host-answer-input').value = '';
    document.getElementById('join-offer-input').value = '';
    document.getElementById('offer-result').classList.add('hidden');
    document.getElementById('answer-result').classList.add('hidden');
    setButtonsEnabled(true);
}

document.getElementById('reset-btn').onclick = resetPeerConnection;

function updateStatus(text, dotClass) {
    document.getElementById('status-text').textContent = text;
    document.getElementById('status-dot').className = `w-2 h-2 rounded-full inline-block ${dotClass}`;
}

function showToast(msg, isError = false) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    toast.querySelector('svg').classList.toggle('text-emerald-400', !isError);
    toast.querySelector('svg').classList.toggle('text-red-400', isError);
    toast.classList.remove('opacity-0', 'pointer-events-none');
    toast.classList.add('opacity-100');
    setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0', 'pointer-events-none');
    }, 2800);
}

function setButtonsEnabled(enabled) {
    ['gen-offer-btn', 'gen-answer-btn', 'accept-answer-btn'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.disabled = !enabled;
    });
}

function togglePasswordVisibility() {
    const input = document.getElementById('shared-password');
    const icon = document.getElementById('eye-icon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`;
    } else {
        input.type = 'password';
        icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
    }
}

/* ---------- Clipboard ---------- */
async function copyText(elementId) {
    const el = document.getElementById(elementId);
    let text = el ? (el.value !== undefined ? el.value : el.textContent) : '';
    text = text.trim();
    if (!text || text === '----') {
        showToast('Nothing to copy yet', true);
        return;
    }
    try {
        await navigator.clipboard.writeText(text);
        showToast('Copied to clipboard');
    } catch {
        if (el && el.select) {
            el.select();
            document.execCommand('copy');
            showToast('Copied to clipboard');
        } else {
            showToast('Copy failed', true);
        }
    }
}

/* ---------- QR Code ---------- */
function showQR(tokenElementId, title) {
    const token = document.getElementById(tokenElementId).value;
    if (!token) {
        showToast('No token available yet', true);
        return;
    }
    currentQRToken = token;
    document.getElementById('qr-title').textContent = title;
    const canvas = document.getElementById('qr-canvas');
    QRCode.toCanvas(canvas, token, {
        width: 260,
        margin: 2,
        color: { dark: '#064e3b', light: '#ffffff' },
        errorCorrectionLevel: 'M'
    }, (err) => {
        if (err) {
            console.error(err);
            showToast('QR generation failed', true);
            return;
        }
        document.getElementById('qr-modal').classList.remove('hidden');
        document.getElementById('qr-modal').classList.add('flex');
    });
}

function hideQR() {
    document.getElementById('qr-modal').classList.add('hidden');
    document.getElementById('qr-modal').classList.remove('flex');
}

async function copyCurrentQRToken() {
    if (!currentQRToken) return;
    try {
        await navigator.clipboard.writeText(currentQRToken);
        showToast('Token copied');
    } catch {
        showToast('Copy failed', true);
    }
}

/* ---------- Crypto ---------- */
async function deriveKey(password) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
        'raw', enc.encode(password), 'PBKDF2', false, ['deriveKey']
    );
    const salt = enc.encode('p2p-messenger-v1-salt');
    return crypto.subtle.deriveKey(
        { name: 'PBKDF2', salt, iterations: 100000, hash: 'SHA-256' },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['encrypt', 'decrypt']
    );
}

async function encryptMessage(plainText) {
    if (!cryptoKey) throw new Error('No crypto key');
    const enc = new TextEncoder();
    const iv = crypto.getRandomValues(new Uint8Array(12));
    const cipher = await crypto.subtle.encrypt(
        { name: 'AES-GCM', iv }, cryptoKey, enc.encode(plainText)
    );
    const combined = new Uint8Array(iv.length + cipher.byteLength);
    combined.set(iv, 0);
    combined.set(new Uint8Array(cipher), iv.length);
    return btoa(String.fromCharCode(...combined));
}

async function decryptMessage(b64) {
    if (!cryptoKey) throw new Error('No crypto key');
    const combined = Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    const iv = combined.slice(0, 12);
    const data = combined.slice(12);
    const plain = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv }, cryptoKey, data
    );
    return new TextDecoder().decode(plain);
}

function getPassword() {
    const pwd = document.getElementById('shared-password').value.trim();
    if (pwd.length < 8) {
        showToast('Shared password must be at least 8 characters', true);
        return null;
    }
    return pwd;
}

/* ---------- WebRTC ---------- */
function createPeerConnection(isHost) {
    if (peerConnection) return peerConnection;

    peerConnection = new RTCPeerConnection(rtcConfig);

    peerConnection.onconnectionstatechange = () => {
        const state = peerConnection.connectionState;
        const map = {
            new: ['Initializing…', 'bg-slate-400'],
            connecting: ['Connecting…', 'bg-blue-500'],
            connected: ['Connected (Secure)', 'bg-emerald-500'],
            disconnected: ['Disconnected', 'bg-amber-500'],
            failed: ['Connection failed', 'bg-red-500'],
            closed: ['Closed', 'bg-slate-400']
        };
        const [text, cls] = map[state] || ['Unknown', 'bg-slate-400'];
        updateStatus(text, cls);
        document.getElementById('conn-detail').textContent =
            state === 'connected' ? 'Direct / Relay' : state;

        if (state === 'failed') {
            showToast('Connection failed – try Reset and exchange new tokens', true);
        }
    };

    peerConnection.oniceconnectionstatechange = () => {
        console.log('ICE state:', peerConnection.iceConnectionState);
    };

    peerConnection.onicegatheringstatechange = () => {
        if (peerConnection.iceGatheringState === 'complete' && isGathering) {
            finalizeToken(isHost);
        }
    };

    peerConnection.onicecandidate = (event) => {
        if (!event.candidate && isGathering) {
            finalizeToken(isHost);
        }
    };

    if (isHost) {
        dataChannel = peerConnection.createDataChannel('chat', { ordered: true });
        setupDataChannel();
    } else {
        peerConnection.ondatachannel = (event) => {
            dataChannel = event.channel;
            setupDataChannel();
        };
    }

    return peerConnection;
}

function finalizeToken(isHost) {
    if (tokenFinalized || !peerConnection?.localDescription) return;
    tokenFinalized = true;
    isGathering = false;

    const token = btoa(JSON.stringify(peerConnection.localDescription));
    const shortCode = generateShortCode();

    if (isHost) {
        document.getElementById('offer-output').value = token;
        document.getElementById('offer-short-code').textContent = shortCode;
        document.getElementById('offer-result').classList.remove('hidden');
        document.getElementById('gen-offer-label').textContent = 'Generate Offer Token';
        showToast('Offer ready – share QR or short code + token');
        updateStatus('Waiting for Answer…', 'bg-blue-500');
    } else {
        document.getElementById('answer-output').value = token;
        document.getElementById('answer-short-code').textContent = shortCode;
        document.getElementById('answer-result').classList.remove('hidden');
        document.getElementById('gen-answer-label').textContent = 'Generate Answer Token';
        showToast('Answer ready – share QR or short code + token');
        updateStatus('Answer ready to send…', 'bg-blue-500');
    }
    setButtonsEnabled(true);
}

async function generateOffer() {
    const pwd = getPassword();
    if (!pwd) return;

    try {
        setButtonsEnabled(false);
        document.getElementById('gen-offer-label').textContent = 'Gathering ICE…';
        updateStatus('Gathering candidates…', 'bg-blue-500');
        tokenFinalized = false;
        isGathering = true;
        document.getElementById('offer-result').classList.add('hidden');

        cryptoKey = await deriveKey(pwd);
        const pc = createPeerConnection(true);
        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);

        setTimeout(() => {
            if (isGathering && pc.localDescription) finalizeToken(true);
        }, 4000);
    } catch (err) {
        console.error(err);
        showToast('Error generating offer', true);
        setButtonsEnabled(true);
        document.getElementById('gen-offer-label').textContent = 'Generate Offer Token';
    }
}

async function generateAnswer() {
    const pwd = getPassword();
    if (!pwd) return;

    const inputVal = document.getElementById('join-offer-input').value.trim();
    if (!inputVal) {
        showToast('Paste the offer token first', true);
        return;
    }

    try {
        setButtonsEnabled(false);
        document.getElementById('gen-answer-label').textContent = 'Gathering ICE…';
        updateStatus('Gathering candidates…', 'bg-blue-500');
        tokenFinalized = false;
        isGathering = true;
        document.getElementById('answer-result').classList.add('hidden');

        cryptoKey = await deriveKey(pwd);
        const pc = createPeerConnection(false);

        const offerObj = JSON.parse(atob(inputVal));
        await pc.setRemoteDescription(new RTCSessionDescription(offerObj));

        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);

        setTimeout(() => {
            if (isGathering && pc.localDescription) finalizeToken(false);
        }, 4000);
    } catch (err) {
        console.error(err);
        showToast('Invalid offer token or crypto error', true);
        setButtonsEnabled(true);
        document.getElementById('gen-answer-label').textContent = 'Generate Answer Token';
    }
}

async function acceptAnswer() {
    const inputVal = document.getElementById('host-answer-input').value.trim();
    if (!inputVal) {
        showToast('Paste the answer token first', true);
        return;
    }
    if (!peerConnection) {
        showToast('Generate an offer first', true);
        return;
    }

    try {
        setButtonsEnabled(false);
        const answerObj = JSON.parse(atob(inputVal));
        await peerConnection.setRemoteDescription(new RTCSessionDescription(answerObj));
        updateStatus('Connecting…', 'bg-amber-500');
        showToast('Answer accepted – connecting…');
    } catch (err) {
        console.error(err);
        showToast('Invalid answer token', true);
        setButtonsEnabled(true);
    }
}

function setupDataChannel() {
    dataChannel.onopen = () => {
        updateStatus('Connected (Secure)', 'bg-emerald-500');
        document.getElementById('setup-view').classList.add('hidden');
        document.getElementById('chat-view').classList.remove('hidden');
        document.getElementById('reset-btn').classList.remove('hidden');
        document.getElementById('chat-input').focus();
        showToast('Secure encrypted channel established');
    };

    dataChannel.onclose = () => {
        updateStatus('Disconnected', 'bg-amber-500');
        showToast('Connection closed', true);
    };

    dataChannel.onerror = (e) => {
        console.error('DataChannel error', e);
        showToast('Data channel error', true);
    };

    dataChannel.onmessage = async (event) => {
        try {
            const plain = await decryptMessage(event.data);
            appendMessage(plain, 'incoming');
        } catch (err) {
            console.error('Decrypt failed', err);
            appendMessage('[Unable to decrypt – wrong password?]', 'incoming');
        }
    };
}

/* ---------- Messaging ---------- */
async function sendMessage() {
    const input = document.getElementById('chat-input');
    const message = input.value.trim();
    if (!message) return;

    if (!dataChannel || dataChannel.readyState !== 'open') {
        showToast('Channel is not open', true);
        return;
    }

    try {
        const encrypted = await encryptMessage(message);
        dataChannel.send(encrypted);
        appendMessage(message, 'outgoing');
        input.value = '';
        input.focus();
    } catch (err) {
        console.error(err);
        showToast('Encryption failed', true);
    }
}

function handleKey(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
}

function appendMessage(text, type) {
    const container = document.getElementById('messages-container');
    const bubble = document.createElement('div');
    const isOutgoing = type === 'outgoing';
    bubble.className = `flex ${isOutgoing ? 'justify-end' : 'justify-start'}`;

    const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

    bubble.innerHTML = `
        <div class="max-w-[80%] rounded-2xl px-4 py-2.5 text-sm shadow-sm ${
            isOutgoing
                ? 'bg-emerald-600 text-white rounded-br-md'
                : 'bg-white border border-slate-200 text-slate-800 rounded-bl-md'
        }">
            <p class="break-anywhere leading-relaxed">${escapeHtml(text)}</p>
            <span class="block text-[10px] mt-1 text-right ${
                isOutgoing ? 'text-emerald-100' : 'text-slate-400'
            }">${timeStr}</span>
        </div>
    `;
    container.appendChild(bubble);
    container.scrollTop = container.scrollHeight;
}

function escapeHtml(text) {
    const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
    return String(text).replace(/[&<>"']/g, m => map[m]);
}

window.addEventListener('offline', () => {
    showToast('You are offline – WebRTC needs network for ICE', true);
});
